# Copy this file to .env and fill in only the integrations you want.
# StockLens runs without these keys. Historical prices, technical indicators,
# and the machine-learning pages do not need them.

# NewsAPI.org key for recent headlines (https://newsapi.org).
# The news page explains how to add this if it is empty.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2

# Optional OpenAI-compatible chat API for narrative explanations.
# If LLM_API_KEY is empty, StockLens uses a template written from calculated results.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# FinBERT model id. The default is the financial sentiment model required by StockLens.
FINBERT_MODEL=ProsusAI/finbert

# SQLite file for download logs, prediction records, and analysis notes.
# Relative paths are resolved from the project root.
DATABASE_PATH=data/stocklens.db
